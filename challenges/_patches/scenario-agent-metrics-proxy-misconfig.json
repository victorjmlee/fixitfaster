{
  "description": "Datadog Agent가 DogStatsD 메트릭을 중간 Vector 프록시로 보내도록 설정하지만, Vector 프록시는 Datadog으로 메트릭을 전달하지 않도록 구성됩니다. 이로 인해 Agent 메트릭이 Datadog UI에 나타나지 않습니다.",
  "service": "agent",
  "envAdd": [
    [
      "DD_DOGSTATSD_URL",
      "udp://vector:8125"
    ]
  ],
  "envRemove": [],
  "newService": {
    "serviceName": "vector",
    "image": "timberio/vector:0.34.0-alpine",
    "container_name": "fixitfaster-vector-proxy",
    "ports": [
      "8125:8125/udp"
    ],
    "volumes": [
      "./conf.d/vector/vector.toml:/etc/vector/vector.toml:ro"
    ],
    "restart": "unless-stopped"
  },
  "configFiles": [
    {
      "path": "conf.d/vector/vector.toml",
      "content": "[sources.dogstatsd_source]\n  type = \"dogstatsd\"\n  address = \"0.0.0.0:8125\"\n"
    }
  ]
}